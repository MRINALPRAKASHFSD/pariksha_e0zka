# ==============================================================================
# Pariksha Environment Configuration Template
# Keep real secrets OUTSIDE iCloud Drive (e.g., ~/.config/pariksha/.env or
# set PARIKSHA_ENV_FILE=/path/outside/icloud/.env). NEVER commit real .env files.
# ==============================================================================

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL 16 connection strings
DATABASE_URL="postgresql://postgres@localhost:5432/pariksha?schema=public"
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/pariksha_test?schema=public"

# Session & CSRF secrets (generate strong random 64-byte hex secrets for production)
SESSION_SECRET="replace-with-64-char-random-secret-in-local-env"
CSRF_SECRET="replace-with-64-char-random-csrf-secret-in-local-env"
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# File uploads (point outside iCloud Drive in production/heavy usage)
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_BYTES=10485760

# Bootstrap / Seed configuration (provide via secure env outside Git)
# BOOTSTRAP_ADMIN_EMAIL=admin@pariksha.local
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME="Pariksha System Administrator"
# SEED_DEV_ACCOUNTS=false
# SEED_DEV_TEACHER_PASSWORD=
# SEED_DEV_STUDENT_PASSWORD=

# Vite frontend API proxy/origin
VITE_API_BASE_URL="/api/v1"
VITE_SOCKET_URL="http://localhost:4000"
